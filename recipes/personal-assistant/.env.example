# These are set automatically by Supabase when you deploy an Edge Function.
# You only need to set MCP_ACCESS_KEY and DEFAULT_USER_ID manually
# (reuse the same values as your core Open Brain function).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
MCP_ACCESS_KEY=your-mcp-access-key
DEFAULT_USER_ID=your-open-brain-user-uuid
